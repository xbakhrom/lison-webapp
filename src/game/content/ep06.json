  "intro": [
    {
      "textUz": "Bugun Anna tug'ilgan kunini nishonlayapti — bizni chaqirdi! Sovg'a KIMGA berilishini дательный kelishik aytadi."
    },
    {
      "textUz": "Yosh ham shu kelishik bilan: ruslar «menga 20 yil» deydi.",
      "ru": "Мне 20 лет. Ско́лько тебе лет?"
    },
    {
      "textUz": "Год, года yoki лет — songa qarang. 11–14 esa yana tuzoq! Oltin ⭐ sovg'alarga ehtiyot bo'l."
    }
  ],
  "ruleCards": [
