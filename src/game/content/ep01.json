{
  "id": "ep01",
  "order": 1,
  "title": "Аэропорт",
  "titleUz": "Aeroport",
  "topic": "rod",
  "topicUz": "Ot jinsi (род)",
  "summaryUz": "Bagaj lentasidagi buyumlarni rod bo'yicha uchta aravaga saralang.",
  "icon": "✈️",
  "intro": [
    {
      "textUz": "Salom! Men — Barsik. Sen Temursan, shundaymi? Bagajing lentada aylanib yuribdi."
    },
    {
      "textUz": "Moskvada har bir narsaning «jinsi» bor: он, она yoki оно. Buni bilmasang, keyingi hech qaysi kelishik ishlamaydi.",
      "ru": "он — она — оно"
    },
    {
      "textUz": "Buyumlarni uchta aravaga saralaymiz. Oltin rangda yaltiragan ⭐ so'zlarga ehtiyot bo'l — ular qoidaga bo'ysunmaydi."
    }
  ],
  "ruleCards": [
    {
      "titleUz": "Rod nima?",
      "bodyUz": "Rus tilida har bir ot uch roddan biriga tegishli: мужской (erkaklik), женский (ayollik), средний (o'rta). Tekshirish oson — otni olmosh bilan almashtiring: он, она yoki оно.",
      "examplesRu": [
        "стол — он",
        "кни́га — она́",
        "окно́ — оно́"
      ]
    },
    {
      "titleUz": "Oxirgi harfga qarang",
      "bodyUz": "Asosiy qoida so'z oxirida: undosh bilan tugasa — мужской; -а yoki -я bilan tugasa — женский; -о yoki -е bilan tugasa — средний.",
      "examplesRu": [
        "па́спорт — он",
        "су́мка — она́",
        "письмо́ — оно́",
        "мо́ре — оно́"
      ]
    },
    {
      "titleUz": "-ь bilan tugaganlar ikkilanadi",
      "bodyUz": "Yumshoq belgi (-ь) bilan tugagan otlar ham мужской, ham женский bo'lishi mumkin. Qoida yo'q — har birini lug'at bilan birga yodlang.",
      "examplesRu": [
        "слова́рь — он",
        "тетра́дь — она́",
        "день — он",
        "ночь — она́"
      ]
    },
    {
      "titleUz": "Istisnolar — bosslar",
      "bodyUz": "Ko'rinishi bir xil, rodi boshqa: ко́фе -е bilan tugasa ham мужской; -мя bilan tugaganlar (вре́мя, и́мя) — средний; erkak kishini bildiruvchi па́па, де́душка, дя́дя -а/-я bilan tugasa ham мужской; путь yagona -ь li мужской ot, мышь/ночь/дверь esa женский.",
      "examplesRu": [
        "чёрный ко́фе — он",
        "моё вре́мя — оно́",
        "мой па́па — он",
        "до́лгий путь — он",
        "э́та дверь — она́"
      ],
      "isException": true
    }
  ],
